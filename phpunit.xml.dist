<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         defaultTestSuite="unit"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="true"
         colors="true">
    <!-- PHPUnit 13 holds more per run than PHP's default 128M allows the unit suite (its large-output tests included). -->
    <php>
        <ini name="memory_limit" value="512M"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
            <directory>tests/Support</directory>
        </testsuite>
        <!-- Needs the extension loaded in-process; the unit suite runs it in a child (tests/Unit/Sdk/Backend/ExtensionSuiteTest.php). -->
        <testsuite name="extension">
            <directory>tests/Extension</directory>
        </testsuite>
        <!-- Real Restate server + real extension backend; run with `just test integration php-cli`. examples/testing is the
             public test harness used as a user would. -->
        <testsuite name="integration">
            <directory>tests/Integration</directory>
            <directory>examples/testing</directory>
        </testsuite>
        <!-- Only against the integration endpoint in FrankenPHP's worker mode, after the integration suite:
             just test integration frankenphp-worker (RESTATE_PHP_TEST_SERVER=frankenphp-worker). -->
        <testsuite name="worker">
            <directory>tests/Worker</directory>
        </testsuite>
        <!-- Long runs against FrankenPHP worker images (and Restate): just test soak, nightly and weekly. -->
        <testsuite name="soak">
            <directory>tests/Soak</directory>
        </testsuite>
        <!-- The Docker quickstart's walkthrough (examples/quickstart) in Docker Compose: just test quickstart. -->
        <testsuite name="quickstart">
            <directory>tests/Quickstart</directory>
        </testsuite>
    </testsuites>
    <!-- Nightly only (.github/workflows/nightly-serving.yaml, nightly-failure.yaml); phpunit's group option runs one anyway. -->
    <!-- The large scale parameterisations (tests/Integration/Scale) run on their own: the `scale` group of `just test integration php-cli` (nightly). -->
    <groups>
        <exclude>
            <group>large-bodies</group>
            <group>serving-hazards</group>
            <group>failure-nightly</group>
            <group>scale</group>
            <!-- bin/split.sh on a throwaway monorepo: just test release (and just check). -->
            <group>release</group>
        </exclude>
    </groups>
    <!-- ignoreIndirectDeprecations: a deprecation that third-party code triggers in third-party code is not ours to
         fix (PHP 8.6 deprecates the define() call in phpstan.phar's bundled hoa/consistency, which phpstan's rule test
         harness runs); deprecations our code triggers, or calls into, still fail the suite. -->
    <source ignoreIndirectDeprecations="true">
        <include>
            <directory>packages</directory>
        </include>
    </source>
</phpunit>
