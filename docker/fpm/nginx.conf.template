# nginx in front of php-fpm, with the settings docs/SERVING.md ("PHP-FPM and FastCGI") recommends. Rendered by
# entrypoint.sh (RESTATE_PHP_FPM_FRONT=nginx or nginx-h2c, RESTATE_PHP_FPM_PROFILE=recommended).
daemon off;
worker_processes 2;
user www-data;
pid /tmp/nginx.pid;
error_log /proc/self/fd/2 warn;

events {
    worker_connections 1024;
}

http {
    access_log off;
    client_body_temp_path /tmp/nginx-client-body;
    fastcgi_temp_path /tmp/nginx-fastcgi;

    server {
        listen ${RESTATE_PHP_FPM_PORT};
        # On: h2c with prior knowledge (what Restate speaks to a deployment registered without use_http_11) and
        # HTTP/1.1 on the same port (nginx 1.25.1+ tells them apart by the HTTP/2 preface).
        http2 ${RESTATE_PHP_FPM_HTTP2};

        # Restate sends chunked bodies without Content-Length. nginx buffers the whole body (fastcgi_request_buffering
        # on, the default; never turn it off: php-fpm would read 0 bytes) and sends its length, but answers 413 above
        # client_max_body_size, 1m by default. Restate's own limit per message is 32 MiB.
        client_max_body_size 64m;

        # At least the handlers' abort timeout (Restate's default: 600 s); 60 s by default.
        fastcgi_read_timeout ${RESTATE_PHP_FPM_READ_TIMEOUT}s;
        fastcgi_send_timeout ${RESTATE_PHP_FPM_READ_TIMEOUT}s;

        location / {
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME ${RESTATE_PHP_FPM_SCRIPT};
            fastcgi_pass 127.0.0.1:9000;
        }
    }
}
