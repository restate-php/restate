# Caddy php_fastcgi in front of php-fpm with nothing but what routing needs: request buffering and timeouts at
# Caddy's defaults (request_buffers 4096). For the serving-hazards tests (RESTATE_PHP_FPM_PROFILE=defaults).
{
	admin off
	auto_https off
	servers {
		protocols h1 h2c
	}
}

:${RESTATE_PHP_FPM_PORT} {
	root * ${RESTATE_PHP_FPM_ROOT}
	rewrite * /${RESTATE_PHP_FPM_SCRIPT_NAME}
	php_fastcgi 127.0.0.1:9000
}
