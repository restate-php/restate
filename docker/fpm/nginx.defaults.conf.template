# nginx in front of php-fpm with nothing but what routing needs: every body and timeout setting at nginx's defaults
# (client_max_body_size 1m, fastcgi_read_timeout 60s). For the serving-hazards tests (RESTATE_PHP_FPM_PROFILE=defaults).
daemon off;
worker_processes 2;
user www-data;
pid /tmp/nginx.pid;
error_log /proc/self/fd/2 warn;

events {
    worker_connections 1024;
}

http {
    access_log off;
    client_body_temp_path /tmp/nginx-client-body;
    fastcgi_temp_path /tmp/nginx-fastcgi;

    server {
        listen ${RESTATE_PHP_FPM_PORT};
        http2 ${RESTATE_PHP_FPM_HTTP2};

        location / {
            include /etc/nginx/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME ${RESTATE_PHP_FPM_SCRIPT};
            fastcgi_pass 127.0.0.1:9000;
        }
    }
}
