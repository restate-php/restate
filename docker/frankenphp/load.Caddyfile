# Load-test endpoint (bin/load-test.sh): every request goes to the load router script, which the
# runner mounts with the repository at /app. LOAD_NUM_THREADS sets FrankenPHP's PHP thread count
# (default: twice the CPUs it sees), so an overload run can cap the endpoint's capacity.
{
	admin off
	auto_https off
	frankenphp {
		num_threads {$LOAD_NUM_THREADS:0}
	}
}

:8080 {
	root * /app/tests/Load/Support
	rewrite * /endpoint.php
	php
}
