# Integration-suite endpoint: every request goes to the harness router script, as with php -S.
# The image has no php.ini, so display_errors stays on (PHP's default, as the stray-output tests
# want); enable_post_data_reading=0 as docs/serving.md recommends, so a journal over post_max_size
# (LongJournalTest) does not make PHP print a startup warning into every attempt's response.
# num_threads is pinned rather than FrankenPHP's default (twice the CPUs, so 8 on a 4-vCPU CI
# runner): in classic mode the PHP thread reads the request body itself, so a request whose body
# stalls holds its thread until the body arrives (or request_body_timeout, 60 s, cuts it off).
# RequestStallTest stalls 12 bodies and expects /health to keep answering; 16 threads keep that
# independent of the machine's CPU count.
#
# The frankenphp-extension image serves the repository mounted at /app on :8080. devenv.nix's
# frankenphp profile serves the working tree with the same file (languages.php.frankenphp.serve):
# RESTATE_PHP_TEST_APP_DIR     the repository (default /app)
# RESTATE_PHP_TEST_LISTEN      the site address (default :8080)
# CADDY_GLOBAL_OPTIONS         more global options (the image sets it empty; devenv binds loopback)
{
	admin off
	auto_https off
	{$CADDY_GLOBAL_OPTIONS}
	frankenphp {
		num_threads 16
		php_ini enable_post_data_reading 0
	}
}

{$RESTATE_PHP_TEST_LISTEN::8080} {
	root * {$RESTATE_PHP_TEST_APP_DIR:/app}/tests/Integration/Support
	rewrite * /endpoint.php
	php
}
