# The SDK conformance suite's service container (the conformance-frankenphp image): every request goes to
# test-services/index.php, baked into the image at /app, in FrankenPHP classic mode on :9080, the port the
# suite calls, over h2c or HTTP/1.1. enable_post_data_reading=0 as docs/serving.md recommends. Classic
# mode starts every request afresh, as php -S does, so FrankenPHP's default threads (twice the CPUs)
# share nothing in memory.
{
	admin off
	auto_https off
	servers :9080 {
		protocols h1 h2c
	}
	frankenphp {
		php_ini enable_post_data_reading 0
	}
}

:9080 {
	root * /app/test-services
	rewrite * /index.php
	php
}
