set lazy
set default-list
set ignore-comments
# The suites run from the repository root, as phpunit.xml.dist expects.
set working-directory := '..'

# The images' build settings, for every recipe: RESTATE_PHP_TEST_SKIP_BUILD=1 reuses the images;
# RESTATE_PHP_TEST_EXTENSION_PROFILE (debug, the default, or release) chooses the extension build
# of the fpm and frankenphp images; RESTATE_PHP_TEST_FRANKENPHP_BASE_IMAGE and
# RESTATE_PHP_TEST_FPM_BASE_IMAGE replace the Dockerfile's FrankenPHP and php-fpm bases.
frankenphp_image := env('RESTATE_PHP_TEST_FRANKENPHP_IMAGE', 'restate.local/restate-php-frankenphp:extension-zts')

# RESTATE_PHP_TEST_SERVER lists the servers, space-separated: nginx-fpm (HTTP/1.1), nginx-fpm-h2c,
# caddy-fpm (both h2c); all three by default. The container mounts the repository, so PHP
# changes need no rebuild; Rust changes (extension/) and changes under docker/fpm/ do.
# RESTATE_PHP_TEST_FPM_IMAGE (the tag), RESTATE_PHP_TEST_FPM_TARGET (fpm-extension;
# serving-hazards builds fpm-extension-apache).
[doc("Integration suite on PHP-FPM behind nginx and Caddy (fpm-extension image), once per server; arguments go to phpunit")]
[positional-arguments]
[script('bash')]
fpm *phpunit: host-extension
    set -euo pipefail
    image=${RESTATE_PHP_TEST_FPM_IMAGE:-restate.local/restate-php-fpm:extension}
    read -r -a servers <<<"${RESTATE_PHP_TEST_SERVER:-nginx-fpm nginx-fpm-h2c caddy-fpm}"
    for server in "${servers[@]}"; do
        case $server in
            nginx-fpm | nginx-fpm-h2c | caddy-fpm) ;;
            *) echo "RESTATE_PHP_TEST_SERVER must list nginx-fpm, nginx-fpm-h2c or caddy-fpm, got '$server'" >&2 && exit 64 ;;
        esac
    done
    if [ "${RESTATE_PHP_TEST_SKIP_BUILD:-0}" != 1 ]; then
        docker build --build-arg "PHP_FPM_IMAGE=${RESTATE_PHP_TEST_FPM_BASE_IMAGE:-}" \
            --build-arg "EXTENSION_PROFILE=${RESTATE_PHP_TEST_EXTENSION_PROFILE:-}" \
            --target "${RESTATE_PHP_TEST_FPM_TARGET:-fpm-extension}" -f docker/Dockerfile -t "$image" .
    fi
    status=0
    for server in "${servers[@]}"; do
        echo "== integration suite on $server ($image)" >&2
        RESTATE_PHP_TEST_SERVER=$server RESTATE_PHP_TEST_FPM_IMAGE=$image \
            vendor/bin/phpunit --testsuite integration "$@" || status=$?
    done
    exit "$status"

# The group starts nginx, Caddy and Apache front doors of its own, so it builds the
# fpm-extension-apache image (fpm-extension with Apache added) as RESTATE_PHP_TEST_FPM_IMAGE and
# runs once, on nginx-fpm.
# It waits out real timeouts. Settings as for `fpm`.
[doc("The serving-hazards group (front doors' body limits and timeouts, clear_env) on PHP-FPM behind nginx, Caddy and Apache; arguments go to phpunit")]
[positional-arguments]
serving-hazards *phpunit:
    RESTATE_PHP_TEST_SERVER=nginx-fpm RESTATE_PHP_TEST_FPM_TARGET=fpm-extension-apache \
        RESTATE_PHP_TEST_FPM_IMAGE=restate.local/restate-php-fpm:extension-apache \
        {{ quote(just_executable()) }} --justfile {{ quote(justfile()) }} test fpm --group serving-hazards "$@"

# The router script runs per request (RESTATE_PHP_TEST_SERVER=frankenphp). The container mounts
# the repository, so PHP changes need no rebuild; Rust changes (extension/) do.
# RESTATE_PHP_TEST_FRANKENPHP_IMAGE (the tag).
[doc("Integration suite on FrankenPHP classic mode (frankenphp-extension image, the ZTS extension); arguments go to phpunit")]
[positional-arguments]
frankenphp *phpunit: host-extension frankenphp-image
    RESTATE_PHP_TEST_SERVER=frankenphp RESTATE_PHP_TEST_FRANKENPHP_IMAGE={{ quote(frankenphp_image) }} \
        vendor/bin/phpunit --testsuite integration "$@"

# docker/frankenphp/worker.Caddyfile, with tests/Integration/Support/worker.php building the
# endpoints once per worker (RESTATE_PHP_TEST_SERVER=frankenphp-worker); the worker suite
# (tests/Worker) runs after the integration suite. Settings as for `frankenphp`.
[doc("Integration and worker suites on FrankenPHP worker mode (frankenphp-extension image); arguments go to phpunit")]
[positional-arguments]
frankenphp-worker *phpunit: host-extension frankenphp-image
    RESTATE_PHP_TEST_SERVER=frankenphp-worker RESTATE_PHP_TEST_FRANKENPHP_IMAGE={{ quote(frankenphp_image) }} \
        vendor/bin/phpunit --testsuite integration,worker "$@"

# nightly: frames, concurrency and bailout (the default); frames: FrameReplaySoakTest, about a
# million requests; concurrency: ConcurrencySoakTest, many PHP threads in one process; bailout:
# BailoutSoakTest, fatal errors and worker restarts; restate: RestateSoakTest, about 300,000
# invocations through Restate (RESTATE_PHP_SOAK_INVOCATIONS); all: everything. --quick runs a few
# percent of the requests (RSS reported, not gated). Builds the frankenphp-extension image with
# the diagnostics feature, in release and debug builds as the tests need; reports go to
# var/soak/. RESTATE_PHP_SOAK_RELEASE_IMAGE, RESTATE_PHP_SOAK_DEBUG_IMAGE (the tags).
[arg('quick', long='quick', value='1', help="a few percent of the requests, for a local run")]
[doc("Soak suite (tests/Soak) on FrankenPHP worker mode with the diagnostics build: nightly (default), frames, concurrency, bailout, restate or all; phpunit arguments after --")]
[positional-arguments]
[script('bash')]
soak quick='0' suite='nightly' *phpunit:
    set -euo pipefail
    shift 2
    release=${RESTATE_PHP_SOAK_RELEASE_IMAGE:-restate.local/restate-php-frankenphp:diagnostics-release}
    debug=${RESTATE_PHP_SOAK_DEBUG_IMAGE:-restate.local/restate-php-frankenphp:diagnostics-debug}
    case {{ quote(suite) }} in
        nightly) filter='FrameReplaySoakTest|ConcurrencySoakTest|BailoutSoakTest' profiles=(release debug) ;;
        frames) filter=FrameReplaySoakTest profiles=(release) ;;
        concurrency) filter=ConcurrencySoakTest profiles=(release debug) ;;
        bailout) filter=BailoutSoakTest profiles=(debug) ;;
        restate) filter=RestateSoakTest profiles=(release) ;;
        all) filter=SoakTest profiles=(release debug) ;;
        *) echo "soak: the suite is nightly, frames, concurrency, bailout, restate or all, not {{ suite }}" >&2 && exit 64 ;;
    esac
    if [ "${RESTATE_PHP_TEST_SKIP_BUILD:-0}" != 1 ]; then
        for profile in "${profiles[@]}"; do
            if [ "$profile" = release ]; then tag=$release; else tag=$debug; fi
            docker build --build-arg "FRANKENPHP_IMAGE=${RESTATE_PHP_TEST_FRANKENPHP_BASE_IMAGE:-}" \
                --build-arg "EXTENSION_PROFILE=$profile" --build-arg EXTENSION_FEATURES=diagnostics \
                --target frankenphp-extension -f docker/Dockerfile -t "$tag" .
        done
    fi
    RESTATE_PHP_SOAK_QUICK={{ quick }} RESTATE_PHP_SOAK_RELEASE_IMAGE=$release RESTATE_PHP_SOAK_DEBUG_IMAGE=$debug \
        exec vendor/bin/phpunit --testsuite soak --filter "$filter" "$@"

# The frankenphp-extension image (the ZTS extension compiled inside the FrankenPHP image)
[private]
frankenphp-image:
    [ "${RESTATE_PHP_TEST_SKIP_BUILD:-0}" = 1 ] || docker build \
        --build-arg "FRANKENPHP_IMAGE=${RESTATE_PHP_TEST_FRANKENPHP_BASE_IMAGE:-}" \
        --build-arg "EXTENSION_PROFILE=${RESTATE_PHP_TEST_EXTENSION_PROFILE:-}" \
        --target frankenphp-extension -f docker/Dockerfile -t {{ quote(frankenphp_image) }} .

# The host's extension build (debug), which the integration suite's own endpoints load next to
# the image's: php -S for examples/testing and the tests that start an endpoint of their own.
[private]
host-extension:
    {{ quote(just_executable()) }} --justfile {{ quote(justfile()) }} extension build >/dev/null
