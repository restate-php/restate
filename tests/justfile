set lazy
set default-list
set ignore-comments
# The suites run from the repository root, as phpunit.xml.dist expects.
set working-directory := '..'

# The images' build settings, for every recipe (bin/build-image.sh builds them):
# RESTATE_PHP_TEST_SKIP_BUILD=1 reuses the images; RESTATE_PHP_TEST_PHP_VERSION (8.4, the default,
# 8.5 or 8.6) chooses the PHP minor of the fpm and frankenphp images, and
# RESTATE_PHP_TEST_EXTENSION_PROFILE (debug, the default, or release) their extension build;
# RESTATE_PHP_IMAGE_EXTENSION (container, the default, or host) where Nix builds that module.

# The unit suite's `extension` group runs the extension (tests/Extension) in child processes.
[doc("Build the extension, then run the unit suite; arguments go to phpunit")]
[positional-arguments]
unit *phpunit: host-extension
    vendor/bin/phpunit --testsuite unit "$@"

# bin/split.sh on a throwaway monorepo pushing to local bare repositories: a release, a re-run,
# the next release, a push to main, a release of a commit later pushes passed, and the runs that
# must stop (tests/Unit/Release). The unit suite leaves the group out; `just check` runs it.
[doc("The release group: bin/split.sh against local bare repositories; arguments go to phpunit")]
[positional-arguments]
release *phpunit:
    vendor/bin/phpunit --testsuite unit --group release "$@"

# The server is one of RESTATE_PHP_TEST_SERVER's values:
# - php-cli: php -S on the host with the host's extension build;
# - frankenphp: FrankenPHP classic mode, the router script per request (frankenphp-extension image,
#   the ZTS extension);
# - frankenphp-worker: FrankenPHP worker mode (docker/frankenphp/worker.Caddyfile, with
#   tests/Integration/Support/worker.php building the endpoints once per worker), same image; the
#   worker suite (tests/Worker) runs after the integration suite;
# - nginx-fpm (HTTP/1.1), nginx-fpm-h2c, caddy-fpm (both h2c): php-fpm behind that front door
#   (fpm-extension image).
# The containers mount the repository, so PHP changes need no rebuild; Rust changes (extension/)
# and changes under docker/ do. RESTATE_PHP_TEST_FRANKENPHP_IMAGE and RESTATE_PHP_TEST_FPM_IMAGE
# (the tags), RESTATE_PHP_TEST_FPM_TARGET (fpm-extension; serving-hazards builds
# fpm-extension-apache).
#
# RESTATE_PHP_TEST_RESTATE chooses Restate: container (the default; RESTATE_PHP_RESTATE_IMAGE),
# process (restate-server from the dev shell: no container runtime needed, macOS included) or
# external (a Restate and an endpoint that run outside the harness, which only connects to them:
# those of a devenv.nix profile, `devenv --profile frankenphp test`, or `devenv --profile
# frankenphp up` and this recipe in its shell). With process and external, examples/testing is
# left out: it shows a user the default, a container. With external, nothing is built, and the
# tests that start, stop or configure Restate or the endpoint themselves (group `managed`) are left
# out with the groups phpunit.xml.dist excludes (a command-line --exclude-group replaces that list).
[doc("Integration suite on one server: php-cli, frankenphp, frankenphp-worker, nginx-fpm, nginx-fpm-h2c or caddy-fpm; arguments after the server go to phpunit")]
[positional-arguments]
[script('bash')]
integration server *phpunit:
    set -euo pipefail
    shift
    server={{ quote(server) }}
    restate=${RESTATE_PHP_TEST_RESTATE:-container}
    build=1
    if [ "${RESTATE_PHP_TEST_SKIP_BUILD:-0}" = 1 ]; then build=0; fi
    case $server in
        php-cli | frankenphp | frankenphp-worker | nginx-fpm | nginx-fpm-h2c | caddy-fpm) ;;
        *) echo "integration: the server is php-cli, frankenphp, frankenphp-worker, nginx-fpm, nginx-fpm-h2c or caddy-fpm, not '$server'" >&2 && exit 64 ;;
    esac
    case $restate in
        container)
            tests=(--testsuite integration)
            if [ "$server" = frankenphp-worker ]; then tests=(--testsuite integration,worker); fi
            ;;
        process | external)
            tests=(tests/Integration)
            if [ "$server" = frankenphp-worker ]; then tests+=(tests/Worker); fi
            ;;
        *) echo "integration: RESTATE_PHP_TEST_RESTATE is container, process or external, not '$restate'" >&2 && exit 64 ;;
    esac
    if [ "$restate" = external ]; then
        build=0
        for group in managed large-bodies serving-hazards failure-nightly scale release; do
            tests+=(--exclude-group "$group")
        done
    else
        # The host's extension (debug), which the suite's own php -S endpoints load next to the image's.
        {{ quote(just_executable()) }} --justfile {{ quote(justfile()) }} extension build >/dev/null
    fi
    image_settings=(--php "${RESTATE_PHP_TEST_PHP_VERSION:-8.4}" --variant "${RESTATE_PHP_TEST_EXTENSION_PROFILE:-debug}")
    case $server in
        frankenphp | frankenphp-worker)
            image=${RESTATE_PHP_TEST_FRANKENPHP_IMAGE:-restate.local/restate-php-frankenphp:extension-zts}
            export RESTATE_PHP_TEST_FRANKENPHP_IMAGE=$image
            if [ "$build" = 1 ]; then
                bash bin/build-image.sh "${image_settings[@]}" frankenphp-extension "$image"
            fi
            ;;
        nginx-fpm | nginx-fpm-h2c | caddy-fpm)
            image=${RESTATE_PHP_TEST_FPM_IMAGE:-restate.local/restate-php-fpm:extension}
            export RESTATE_PHP_TEST_FPM_IMAGE=$image
            if [ "$build" = 1 ]; then
                bash bin/build-image.sh "${image_settings[@]}" "${RESTATE_PHP_TEST_FPM_TARGET:-fpm-extension}" "$image"
            fi
            ;;
    esac
    RESTATE_PHP_TEST_SERVER=$server exec vendor/bin/phpunit "${tests[@]}" "$@"

# The group starts nginx, Caddy and Apache front doors of its own, so it builds the
# fpm-extension-apache image (fpm-extension with Apache added) as RESTATE_PHP_TEST_FPM_IMAGE and
# runs once, on nginx-fpm.
# It waits out real timeouts. Settings as for `integration`.
[doc("The serving-hazards group (front doors' body limits and timeouts, clear_env) on PHP-FPM behind nginx, Caddy and Apache; arguments go to phpunit")]
[positional-arguments]
serving-hazards *phpunit:
    RESTATE_PHP_TEST_FPM_TARGET=fpm-extension-apache \
        RESTATE_PHP_TEST_FPM_IMAGE=restate.local/restate-php-fpm:extension-apache \
        {{ quote(just_executable()) }} --justfile {{ quote(justfile()) }} integration nginx-fpm --group serving-hazards "$@"

# nightly: frames, concurrency and bailout (the default); frames: FrameReplaySoakTest, about a
# million requests; concurrency: ConcurrencySoakTest, many PHP threads in one process; bailout:
# BailoutSoakTest, fatal errors and worker restarts; restate: RestateSoakTest, about 300,000
# invocations through Restate (RESTATE_PHP_SOAK_INVOCATIONS); all: everything. --quick runs a few
# percent of the requests (RSS reported, not gated). Builds the frankenphp-extension image with
# the diagnostics builds, release and debug as the tests need; reports go to var/soak/.
# RESTATE_PHP_SOAK_RELEASE_IMAGE, RESTATE_PHP_SOAK_DEBUG_IMAGE (the tags).
[arg('quick', long='quick', value='1', help="a few percent of the requests, for a local run")]
[doc("Soak suite (tests/Soak) on FrankenPHP worker mode with the diagnostics build: nightly (default), frames, concurrency, bailout, restate or all; phpunit arguments after --")]
[positional-arguments]
[script('bash')]
soak quick='0' suite='nightly' *phpunit:
    set -euo pipefail
    shift 2
    release=${RESTATE_PHP_SOAK_RELEASE_IMAGE:-restate.local/restate-php-frankenphp:diagnostics-release}
    debug=${RESTATE_PHP_SOAK_DEBUG_IMAGE:-restate.local/restate-php-frankenphp:diagnostics-debug}
    case {{ quote(suite) }} in
        nightly) filter='FrameReplaySoakTest|ConcurrencySoakTest|BailoutSoakTest' profiles=(release debug) ;;
        frames) filter=FrameReplaySoakTest profiles=(release) ;;
        concurrency) filter=ConcurrencySoakTest profiles=(release debug) ;;
        bailout) filter=BailoutSoakTest profiles=(debug) ;;
        restate) filter=RestateSoakTest profiles=(release) ;;
        all) filter=SoakTest profiles=(release debug) ;;
        *) echo "soak: the suite is nightly, frames, concurrency, bailout, restate or all, not {{ suite }}" >&2 && exit 64 ;;
    esac
    if [ "${RESTATE_PHP_TEST_SKIP_BUILD:-0}" != 1 ]; then
        for profile in "${profiles[@]}"; do
            if [ "$profile" = release ]; then tag=$release; else tag=$debug; fi
            bash bin/build-image.sh --php "${RESTATE_PHP_TEST_PHP_VERSION:-8.4}" --variant "$profile-diagnostics" \
                frankenphp-extension "$tag"
        done
    fi
    RESTATE_PHP_SOAK_QUICK={{ quick }} RESTATE_PHP_SOAK_RELEASE_IMAGE=$release RESTATE_PHP_SOAK_DEBUG_IMAGE=$debug \
        exec vendor/bin/phpunit --testsuite soak --filter "$filter" "$@"

# Every step of examples/quickstart/README.md in Docker Compose, on the README's ports (8080 and
# 9070: stop a quickstart of your own first), checking that the README still shows the commands
# (tests/Quickstart). local: this checkout, built into the quickstart-php-restate image that
# compose.local.yaml uses (RESTATE_PHP_TEST_SKIP_BUILD=1 reuses it); released: the released
# extension and packages, as a user gets them (PIE and Packagist).
[doc("The Docker quickstart's walkthrough in Docker Compose: local (this checkout, the default) or released (PIE and Packagist); arguments after it go to phpunit")]
[positional-arguments]
[script('bash')]
quickstart source='local' *phpunit:
    set -euo pipefail
    shift
    case {{ quote(source) }} in
        local)
            if [ "${RESTATE_PHP_TEST_SKIP_BUILD:-0}" != 1 ]; then
                bash bin/build-image.sh quickstart-php-restate restate-php-quickstart/php-restate:local
            fi
            ;;
        released) ;;
        *) echo "quickstart: the source is local or released, not '{{ source }}'" >&2 && exit 64 ;;
    esac
    RESTATE_PHP_QUICKSTART={{ quote(source) }} exec vendor/bin/phpunit --testsuite quickstart "$@"

# Java 25 from the dev shell; arguments: [target] [basic|full], see bin/conformance-upstream-local.sh.
[doc("Build a test-services image and run the upstream Restate SDK test suite against it; arguments go to bin/conformance-upstream-local.sh")]
[positional-arguments]
upstream *args:
    bash bin/conformance-upstream-local.sh "$@"

# The host's extension build (debug), which the unit suite's extension group loads in child
# processes and the integration suite's own endpoints next to the image's: php -S for
# examples/testing and the tests that start an endpoint of their own.
[private]
host-extension:
    {{ quote(just_executable()) }} --justfile {{ quote(justfile()) }} extension build >/dev/null
