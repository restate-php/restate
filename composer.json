{
  "name": "restate/monorepo",
  "description": "Development repository of the Restate PHP SDK packages (packages/*); never published.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
    "ext-filter": "*",
    "ext-json": "*",
    "psr/container": "^1.1 || ^2.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "ext-curl": "*",
    "cuyz/valinor": "^2.4",
    "friendsofphp/php-cs-fixer": "^3.95",
    "guzzlehttp/guzzle": "^7.9",
    "guzzlehttp/psr7": "^2.13",
    "phpbench/phpbench": "^1.7",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.4",
    "shipmonk/composer-dependency-analyser": "^1.8",
    "symfony/property-access": "^8.1.11",
    "symfony/property-info": "^6.4 || ^7.0",
    "symfony/serializer": "^8.1.11"
  },
  "replace": {
    "restate/common": "self.version",
    "restate/ingress": "self.version",
    "restate/sdk": "self.version",
    "restate/testing": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Restate\\": [
        "packages/common/src/",
        "packages/sdk/src/"
      ],
      "Restate\\Ingress\\": "packages/ingress/src/",
      "Restate\\Testing\\": "packages/testing/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Restate\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/PHPStan/Fixtures/"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
